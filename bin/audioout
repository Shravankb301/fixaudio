#!/bin/bash
# audioout - switch the macOS audio output device.
#
# Companion to ddcvol: switching to the monitor re-asserts the volume level we
# cached for it, since the panel doesn't remember ours.

set -euo pipefail

SAS="$(command -v SwitchAudioSource || echo /opt/homebrew/bin/SwitchAudioSource)"
DDCVOL="$(dirname "${BASH_SOURCE[0]}")/ddcvol"
MONITOR="${DDCVOL_MONITOR:-CF791}"

current() { "$SAS" -c; }

list() { "$SAS" -a -t output; }

switch_to() {
  local target="$1"

  # Accept a unique case-insensitive prefix so `audioout set cf` works.
  if ! list | grep -qxF "$target"; then
    local matches
    matches="$(list | grep -i -- "$target" || true)"
    local n
    n="$(printf '%s' "$matches" | grep -c . || true)"
    if [[ "$n" == "1" ]]; then
      target="$matches"
    elif [[ "$n" == "0" ]]; then
      echo "no output device matching '$1'. available:" >&2
      list >&2
      exit 1
    else
      echo "'$1' is ambiguous:" >&2
      printf '%s\n' "$matches" >&2
      exit 1
    fi
  fi

  "$SAS" -s "$target" -t output >/dev/null

  # The monitor sits at whatever level its own joystick last left it at, so
  # push our cached value back over DDC.
  if [[ "$target" == "$MONITOR" && -x "$DDCVOL" ]]; then
    sleep 0.4
    "$DDCVOL" sync >/dev/null 2>&1 || true
  fi

  echo "$target"
}

cycle() {
  local cur devices n i next line
  cur="$(current)"
  # No mapfile: macOS ships bash 3.2.
  devices=()
  while IFS= read -r line; do
    [[ -n "$line" ]] && devices+=("$line")
  done < <(list)
  n=${#devices[@]}
  (( n == 0 )) && { echo "no output devices" >&2; exit 1; }

  next=0
  for i in "${!devices[@]}"; do
    if [[ "${devices[$i]}" == "$cur" ]]; then
      next=$(( (i + 1) % n ))
      break
    fi
  done

  switch_to "${devices[$next]}"
}

usage() {
  cat <<EOF
audioout - switch macOS audio output

  audioout             show current device
  audioout list        list available output devices
  audioout cycle       switch to the next device in the list
  audioout set <name>  switch to a device (case-insensitive substring is fine)
EOF
}

case "${1:-current}" in
  current|-c) current ;;
  list|-l)    list ;;
  cycle)      cycle ;;
  set|-s)     switch_to "${2:?need a device name}" ;;
  -h|--help|help) usage ;;
  # Bare device name: `audioout cf791`
  *)          switch_to "$1" ;;
esac
